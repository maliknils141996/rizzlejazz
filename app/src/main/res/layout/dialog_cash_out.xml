<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:padding="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💸 Cash Out / Transfer"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Record money withdrawn or transferred out of your shop."
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

    <!-- AMOUNT -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AMOUNT (RS.) *"
        android:textColor="#F43F5E"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/etOutAmount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_bg"
        android:hint="e.g. 2500"
        android:textColorHint="#475569"
        android:textColor="#FFFFFF"
        android:inputType="numberDecimal"
        android:paddingHorizontal="12dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />

    <!-- SENDER / WITHDRAWN BY -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WITHDRAWN BY (USER NAME) *"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etOutSender"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_bg"
        android:hint="e.g. Shop Owner / Cashier"
        android:text="Shop Owner"
        android:textColorHint="#475569"
        android:textColor="#FFFFFF"
        android:paddingHorizontal="12dp"
        android:textSize="13sp"
        android:layout_marginTop="6dp" />

    <!-- RECIPIENT / SENT TO -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PAID / SENT TO *"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etOutRecipient"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_bg"
        android:hint="e.g. Ali Supplier / Landlord"
        android:textColorHint="#475569"
        android:textColor="#FFFFFF"
        android:paddingHorizontal="12dp"
        android:textSize="13sp"
        android:layout_marginTop="6dp" />

    <!-- PURPOSE / NOTE -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NOTE / PURPOSE *"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etOutPurpose"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_bg"
        android:hint="e.g. Shop inventory purchase / Bill payment"
        android:textColorHint="#475569"
        android:textColor="#FFFFFF"
        android:paddingHorizontal="12dp"
        android:textSize="13sp"
        android:layout_marginTop="6dp" />

    <!-- ACTION BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnOutCancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancel"
            android:textColor="#94A3B8"
            android:backgroundTint="#1E293B"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnOutConfirm"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Deduct &amp; Save"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/btn_rose" />
    </LinearLayout>

</LinearLayout>
