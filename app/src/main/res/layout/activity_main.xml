<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/app_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PayVox"
                    android:textColor="#0F172A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Soundbox &amp; Khata"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- SOUND TOGGLE & LICENSE PILL -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvLicenseBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Active"
                    android:textColor="#6D28D9"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/tab_unselected" />

                <Button
                    android:id="@+id/btnSoundToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="🔊 Voice ON"
                    android:textColor="#6D28D9"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:backgroundTint="#EDE9FE"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>


        <!-- UNIFIED ALL-IN-ONE PERMISSIONS BANNER -->
        <LinearLayout
            android:id="@+id/llNotifBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FEF3C7"
            android:padding="14dp"
            android:elevation="1dp"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvBannerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ تمام پرمیشنز آن کریں (Permissions Required)"
                android:textColor="#92400E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBannerSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="آواز اور کھاتہ چلانے کے لیے ایک کلک میں تمام پرمیشنز آن کریں۔"
                android:textColor="#B45309"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />

            <Button
                android:id="@+id/btnEnableNotif"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="⚡ تمام پرمیشنز الاؤ کریں (Allow All Permissions)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#D97706"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- SOPHISTICATED SEGMENTED FILTER BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/segmented_container"
            android:padding="3dp"
            android:layout_marginTop="18dp">

            <Button
                android:id="@+id/btnFilterToday"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Today"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/tab_selected"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btnFilterYesterday"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Yesterday"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:background="@android:color/transparent"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btnFilterMonth"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1.1"
                android:text="This Month"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:background="@android:color/transparent"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btnFilterCalendar"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="📅 Custom"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:background="@android:color/transparent"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <!-- LUXURY ROYAL PURPLE TOTAL NET BALANCE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_hero_purple"
            android:padding="20dp"
            android:elevation="3dp"
            android:layout_marginTop="16dp">

            <!-- PERIOD BADGE -->
            <TextView
                android:id="@+id/tvPeriodTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY"
                android:textColor="#DDD6FE"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="#20FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Net Balance"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvNetBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs. 0.00"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <!-- SUMMARY PILLS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvTotalInflowSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="↓ In: Rs. 0 (0)"
                    android:textColor="#34D399"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#20FFFFFF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvTotalOutflowSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="↑ Out: Rs. 0 (0)"
                    android:textColor="#FDA4AF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#20FFFFFF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- SLEEK FROSTED SHARE BUTTON -->
            <Button
                android:id="@+id/btnShareSummary"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="💬 Share Summary Report"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="#30FFFFFF"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <!-- SECTION: DUAL ACCOUNTS (JAZZCASH & EASYPAISA) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Account Ledgers"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- 1. JAZZCASH CARD -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_jazzcash_white"
                android:padding="14dp"
                android:elevation="1dp"
                android:layout_marginEnd="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JAZZCASH"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:background="#ED1C24" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvJazzNetBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rs. 0.00"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvJazzInflow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↓ In: Rs. 0"
                    android:textColor="#059669"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvJazzOutflow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ Out: Rs. 0"
                    android:textColor="#E11D48"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 2. EASYPAISA CARD -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_easypaisa_white"
                android:padding="14dp"
                android:elevation="1dp"
                android:layout_marginStart="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EASYPAISA"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:background="#00A651" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEasyNetBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rs. 0.00"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvEasyInflow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↓ In: Rs. 0"
                    android:textColor="#059669"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvEasyOutflow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ Out: Rs. 0"
                    android:textColor="#E11D48"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- LIVE TRANSACTIONS FEED HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="22dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Live Transactions Feed"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDateRangeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- BANK & WALLET FILTER DROPDOWN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_white"
            android:paddingHorizontal="14dp"
            android:elevation="1dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏦 والٹ / بینک:"
                android:textColor="#0F172A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerBankFilter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:spinnerMode="dropdown" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textColor="#6D28D9"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- TRANSACTION SEARCH BOX -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_white"
            android:paddingHorizontal="14dp"
            android:elevation="1dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etSearchTransactions"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search transactions (e.g. 60, JazzCash, TID...)"
                android:textColorHint="#94A3B8"
                android:textColor="#0F172A"
                android:textSize="12sp"
                android:layout_marginStart="8dp"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btnClearSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✖"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:padding="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- EMPTY STATE -->
        <LinearLayout
            android:id="@+id/llEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="32dp"
            android:visibility="gone"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No transactions found for this period."
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Incoming JazzCash and Easypaisa payments will appear here."
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- TRANSACTION LIST CONTAINER -->
        <LinearLayout
            android:id="@+id/llTransactionsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PayVox"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
