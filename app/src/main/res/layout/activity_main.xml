<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/app_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PayVox"
                    android:textColor="#0F172A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Soundbox &amp; Khata"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- SOUND TOGGLE & LICENSE PILL -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvLicenseBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Active"
                    android:textColor="#6D28D9"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/tab_unselected" />

                <Button
                    android:id="@+id/btnSoundToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="🔊 Voice ON"
                    android:textColor="#6D28D9"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:backgroundTint="#EDE9FE"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- NOTIFICATION LISTENER HELPER BANNER -->
        <LinearLayout
            android:id="@+id/llNotifBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FEF3C7"
            android:padding="12dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔔 Notification Access Needed"
                android:textColor="#92400E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="To announce incoming payments out loud, grant notification access."
                android:textColor="#B45309"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <Button
                android:id="@+id/btnEnableNotif"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Grant Access"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#D97706"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- HORIZONTAL FILTER BAR (TODAY, YESTERDAY, THIS MONTH, PICK DATE) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFilterToday"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Today"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/tab_selected"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnFilterYesterday"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Yesterday"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:background="@drawable/tab_unselected"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnFilterMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="This Month"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:background="@drawable/tab_unselected"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnFilterCalendar"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="📅 Pick Date"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:background="@drawable/tab_unselected"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- TOP TOTAL NET BALANCE HERO CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_hero_purple"
            android:padding="20dp"
            android:elevation="3dp"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvPeriodTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY'S TOTAL NET BALANCE"
                android:textColor="#DDD6FE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvNetBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs. 0.00"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvTotalInflowSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="↓ Total In: Rs. 0"
                    android:textColor="#A7F3D0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalOutflowSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ Total Out: Rs. 0"
                    android:textColor="#FECDD3"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnShareSummary"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="💬 Share Summary on WhatsApp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#25D366"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <!-- SECTION: DUAL ACCOUNTS (JAZZCASH & EASYPAISA) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Account Ledgers"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- 1. JAZZCASH CARD -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_jazzcash_white"
                android:padding="14dp"
                android:elevation="1dp"
                android:layout_marginEnd="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JAZZCASH"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:background="#ED1C24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8558"
                        android:textColor="#64748B"
                        android:textSize="9sp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvJazzNetBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rs. 0.00"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvJazzInflow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↓ In: Rs. 0"
                    android:textColor="#059669"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvJazzOutflow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ Out: Rs. 0"
                    android:textColor="#E11D48"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 2. EASYPAISA CARD -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_easypaisa_white"
                android:padding="14dp"
                android:elevation="1dp"
                android:layout_marginStart="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EASYPAISA"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:background="#00A651" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3737"
                        android:textColor="#64748B"
                        android:textSize="9sp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEasyNetBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rs. 0.00"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvEasyInflow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↓ In: Rs. 0"
                    android:textColor="#059669"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvEasyOutflow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ Out: Rs. 0"
                    android:textColor="#E11D48"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- LIVE TRANSACTIONS FEED HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="22dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Live Transactions Feed"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDateRangeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- EMPTY STATE -->
        <LinearLayout
            android:id="@+id/llEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="32dp"
            android:visibility="gone"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No transactions found for this period."
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Incoming JazzCash (8558) and Easypaisa (3737) payments will appear here."
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- TRANSACTION LIST CONTAINER -->
        <LinearLayout
            android:id="@+id/llTransactionsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PayVox"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
