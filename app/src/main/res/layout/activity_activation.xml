<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- LOGO ICON -->
        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/app_logo"
            android:elevation="6dp" />

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PayVox"
            android:textColor="#0F172A"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JazzCash &amp; Easypaisa Soundbox Khata"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <!-- PERMISSION QUICK ALLOW BANNER -->
        <LinearLayout
            android:id="@+id/llActivationPermBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔔 Required Voice &amp; SMS Permissions"
                android:textColor="#D97706"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PayVox needs SMS and sound permissions to speak out loud when payment arrives."
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnActivationAllowPerm"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="⚡ Allow Permissions (الاؤ کریں)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#D97706"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- DEVICE ID CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="18dp"
            android:elevation="2dp"
            android:layout_marginTop="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR UNIQUE DEVICE ID:"
                android:textColor="#6D28D9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvDeviceId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PV-XXXX-XXXX"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCopyDeviceId"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Copy ID"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:backgroundTint="#6D28D9"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share this Device ID with support to activate your license."
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- LICENSE INPUT CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="18dp"
            android:elevation="2dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENTER LICENSE KEY"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <EditText
                android:id="@+id/etLicenseKey"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/tab_unselected"
                android:hint="PV-XXXX-YYYY"
                android:textColorHint="#94A3B8"
                android:textColor="#0F172A"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:paddingHorizontal="14dp"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnActivate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Activate License"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#6D28D9"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/tvStatusMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:gravity="center"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- WHATSAPP SUPPORT BUTTON -->
        <Button
            android:id="@+id/btnWhatsAppSupport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="💬 Request Trial / License on WhatsApp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#25D366"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>
